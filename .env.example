# Port the Node server listens on (hosting platforms usually set this for you)
PORT=3001

# Public URL attendees will open. Used for QR codes in the organizer dashboard.
# Leave empty to use whatever address the organizer's browser is on.
PUBLIC_URL=

# Folder where event settings and metrics are saved as JSON
DATA_DIR=./data

# Organizer key for the built-in "demo" event. Change this before going public.
DEMO_ORGANIZER_KEY=demo

# Set to "false" to stop anyone from creating new events from /organize
ALLOW_EVENT_CREATION=true
